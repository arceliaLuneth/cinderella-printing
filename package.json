{
  "name": "cinderella-printing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/windows-fs.cjs ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node --require ./scripts/windows-fs.cjs ./node_modules/next/dist/bin/next build --webpack",
    "start": "node --require ./scripts/windows-fs.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "openapi:generate": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.119.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
