CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
BODY_LIMIT_BYTES=262144
UPLOAD_LIMIT_BYTES=5242880

