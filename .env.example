# Salin file ini sebagai .env lalu isi kredensial langsung di komputer Anda.
# Jangan commit .env dan jangan gunakan prefix NEXT_PUBLIC_ untuk secret.

# Salin connection string PostgreSQL dari Supabase > Connect.
DATABASE_URL=postgresql://postgres.pdbvtgvnivfqywzdoyju@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_FILE=
DATABASE_POOL_MAX=5

SUPABASE_URL=https://pdbvtgvnivfqywzdoyju.supabase.co
# Publishable key (sb_publishable_...) atau legacy anon key.
